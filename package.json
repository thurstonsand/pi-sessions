{
  "name": "pi-sessions",
  "version": "0.6.0",
  "type": "module",
  "description": "Pi session search, ask, handoff, messaging, auto-titling, and indexing tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurstonsand/pi-sessions.git"
  },
  "homepage": "https://github.com/thurstonsand/pi-sessions#readme",
  "bugs": {
    "url": "https://github.com/thurstonsand/pi-sessions/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24 <26"
  },
  "files": [
    "dist",
    "extensions",
    "images"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-sessions.ts"
    ]
  },
  "scripts": {
    "build:broker": "mise run build:broker",
    "lint": "mise run lint",
    "format": "mise run format",
    "typecheck": "mise run typecheck",
    "test": "mise run test",
    "check": "mise run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^25.6.2",
    "strip-ansi": "^7.2.0",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.82.1",
    "@earendil-works/pi-ai": ">=0.82.1",
    "@earendil-works/pi-coding-agent": ">=0.82.1",
    "@earendil-works/pi-tui": ">=0.82.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
