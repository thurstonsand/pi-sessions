{
  "name": "pi-sessions",
  "version": "0.6.0",
  "type": "module",
  "description": "Pi session search, ask, handoff, messaging, auto-titling, and indexing tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurstonsand/pi-sessions.git"
  },
  "homepage": "https://github.com/thurstonsand/pi-sessions#readme",
  "bugs": {
    "url": "https://github.com/thurstonsand/pi-sessions/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24 <26"
  },
  "files": [
    "dist",
    "extensions",
    "images"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-sessions.ts"
    ]
  },
  "scripts": {
    "build:broker": "tsc --project tsconfig.broker.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:broker",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit && npm test",
    "prepare": "npm run build:broker && npm run prepare:husky",
    "prepare:husky": "husky || true"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-agent-core": "^0.80.10",
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^25.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.80.10",
    "@earendil-works/pi-ai": ">=0.80.10",
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "@earendil-works/pi-tui": ">=0.80.10"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  }
}
